rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Chat a'zosimi? Chat hali yaratilmagan bo'lsa (1-1 chatning birinchi xabaridan oldin)
    // chat ID'dagi uid bo'yicha tekshiriladi (ID: uid1_uid2 yoki saved_uid).
    function isMember(chatId) {
      return request.auth != null && (
        (exists(/databases/$(database)/documents/chats/$(chatId)) &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members) ||
        (!exists(/databases/$(database)/documents/chats/$(chatId)) &&
          request.auth.uid in chatId.split('_')));
    }

    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /usernames/{name} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && name.matches('[a-z0-9_]{3,20}');
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    match /chats/{chatId} {
      allow get: if request.auth != null &&
        (resource == null || request.auth.uid in resource.data.members);
      allow list: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.members;
      allow update: if request.auth != null && request.auth.uid in resource.data.members;
      match /messages/{msgId} {
        allow read, create: if isMember(chatId);
        allow update: if isMember(chatId) &&
          (resource.data.from == request.auth.uid ||
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'poll']));
        allow delete: if request.auth != null && resource.data.from == request.auth.uid;
      }
    }
    match /calls/{callId} {
      allow read, write: if request.auth != null;
      match /{sub}/{docId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
